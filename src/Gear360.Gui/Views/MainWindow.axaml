<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Gear360.Gui.ViewModels"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="720"
        x:Class="Gear360.Gui.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Gear 360 Extractor"
        Width="960" Height="760" MinWidth="720" MinHeight="560"
        WindowStartupLocation="CenterScreen">

  <Window.Styles>
    <Style Selector="TextBlock.label">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="Opacity" Value="0.75" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.header">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Opacity" Value="0.8" />
    </Style>
  </Window.Styles>

  <Grid Margin="16" RowSpacing="10"
        RowDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto,Auto,Auto,140">

    <!-- Source -->
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
      <TextBlock Classes="label" Text="Source" Width="90" />
      <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                ItemsSource="{Binding Sources}"
                SelectedItem="{Binding SelectedSource}"
                IsEnabled="{Binding CanChangeSource}"
                PlaceholderText="No camera or folder selected">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="vm:SourceItem">
            <TextBlock Text="{Binding DisplayName}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <Button Grid.Column="2" Content="Refresh" Command="{Binding RefreshCommand}"
              ToolTip.Tip="Look for USB-connected cameras again" />
      <Button Grid.Column="3" Content="Open folder / SD card..." Command="{Binding OpenFolderCommand}"
              ToolTip.Tip="Read from the camera's microSD card in a card reader, or any folder with DCIM" />
    </Grid>

    <TextBlock Grid.Row="1" Classes="hint" Text="{Binding StatusMessage}"
               IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

    <!-- Media list header and selection helpers -->
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
      <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
        <TextBlock Classes="label" Text="Media" />
        <TextBlock Classes="hint" VerticalAlignment="Center" Text="{Binding SelectionSummary}" />
        <TextBlock Classes="hint" VerticalAlignment="Center" Text="Reading..." IsVisible="{Binding IsLoadingMedia}" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
        <Button Content="Select all" Command="{Binding SelectAllCommand}" IsEnabled="{Binding IsIdle}" />
        <Button Content="Videos only" Command="{Binding SelectVideosCommand}" IsEnabled="{Binding IsIdle}" />
        <Button Content="Select none" Command="{Binding SelectNoneCommand}" IsEnabled="{Binding IsIdle}" />
      </StackPanel>
    </Grid>

    <Border Grid.Row="3" BorderThickness="1" CornerRadius="4"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="12,6" ColumnDefinitions="36,*,80,90,150">
          <TextBlock Grid.Column="1" Classes="header" Text="Name" />
          <TextBlock Grid.Column="2" Classes="header" Text="Kind" />
          <TextBlock Grid.Column="3" Classes="header" Text="Size" HorizontalAlignment="Right" />
          <TextBlock Grid.Column="4" Classes="header" Text="Date" Margin="16,0,0,0" />
        </Grid>
        <ListBox ItemsSource="{Binding Media}" IsEnabled="{Binding IsIdle}"
                 SelectionMode="Single" Background="Transparent">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:MediaItemViewModel">
              <Grid ColumnDefinitions="36,*,80,90,150">
                <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" MinWidth="0" />
                <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" Text="{Binding Kind}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="3" Text="{Binding SizeText}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="4" Text="{Binding DateText}" VerticalAlignment="Center" Margin="16,0,0,0" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- Destination -->
    <Grid Grid.Row="4" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
      <TextBlock Classes="label" Text="Copy to" Width="90" />
      <TextBox Grid.Column="1" Text="{Binding Destination}" IsEnabled="{Binding IsIdle}"
               ToolTip.Tip="Files go into a yyyy-MM-dd subfolder per day" />
      <Button Grid.Column="2" Content="Browse..." Command="{Binding BrowseDestinationCommand}" IsEnabled="{Binding IsIdle}" />
    </Grid>

    <!-- Options -->
    <StackPanel Grid.Row="5" Spacing="6" IsEnabled="{Binding IsIdle}">
      <CheckBox Content="Stitch videos to 360° (equirectangular MP4 next to each video; needs ffmpeg)"
                IsChecked="{Binding StitchVideos}" />
      <StackPanel Orientation="Horizontal" Spacing="10" Margin="28,0,0,0" IsEnabled="{Binding StitchVideos}">
        <TextBlock Text="Quality" VerticalAlignment="Center" />
        <ComboBox ItemsSource="{Binding ProfileChoices}" SelectedItem="{Binding SelectedProfileChoice}" Width="130"
                  ToolTip.Tip="Fast for previews, High for YouTube uploads, Max for keeping. Custom: your own Advanced settings.">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:StitchProfileChoice">
              <TextBlock Text="{Binding Name}" ToolTip.Tip="{Binding Description}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Classes="hint" VerticalAlignment="Center" Text="{Binding StitchProfileDescription}" />
      </StackPanel>
      <Expander Header="More stitch settings and ffmpeg" HorizontalAlignment="Stretch">
        <StackPanel Spacing="10">
          <Expander Header="Advanced" HorizontalAlignment="Stretch">
            <StackPanel Spacing="10">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="Encoder" VerticalAlignment="Center" />
                <ComboBox ItemsSource="{Binding Encoders}" SelectedItem="{Binding StitchEncoder}" Width="130" />
                <TextBlock Classes="hint" VerticalAlignment="Center"
                           Text="Auto uses a graphics card encoder (NVIDIA, Intel, AMD, Apple) when one works, else the CPU." />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="Codec" VerticalAlignment="Center" />
                <ComboBox ItemsSource="{Binding Codecs}" SelectedItem="{Binding StitchCodec}" Width="110" />
                <TextBlock Text="CRF (lower is better)" VerticalAlignment="Center" Margin="12,0,0,0" />
                <NumericUpDown Value="{Binding StitchCrf}" Minimum="0" Maximum="51" Increment="1"
                               FormatString="0" Width="120" />
                <TextBlock Text="Preset" VerticalAlignment="Center" Margin="12,0,0,0" />
                <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding StitchPreset}" Width="130"
                          ToolTip.Tip="Slower presets give smaller files at the same quality; mapped to the nearest graphics card preset." />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="Interpolation" VerticalAlignment="Center" />
                <ComboBox ItemsSource="{Binding Interpolations}" SelectedItem="{Binding StitchInterpolation}" Width="130"
                          ToolTip.Tip="How the fisheye pictures are sampled. Linear is fast; Lanczos is a little sharper and about twice as slow." />
                <CheckBox Content="HQ graphics card tuning" IsChecked="{Binding StitchHighQualityTuning}" Margin="12,0,0,0"
                          ToolTip.Tip="NVENC: preset p7, two-pass, spatial and temporal AQ, lookahead, B-frame references. Quick Sync: veryslow. AMF: quality. No effect on the CPU." />
                <TextBlock Text="Audio" VerticalAlignment="Center" Margin="12,0,0,0" />
                <ComboBox ItemsSource="{Binding AudioModes}" SelectedItem="{Binding StitchAudio}" Width="100"
                          ToolTip.Tip="Copy keeps the camera's sound as it is; Aac re-encodes it at 192 kbit/s for players that cannot play the original." />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="Lens FOV" VerticalAlignment="Center" />
                <NumericUpDown Value="{Binding StitchFov}" Minimum="90" Maximum="360" Increment="1"
                               FormatString="0.#" Width="120" />
                <TextBlock Text="Yaw" VerticalAlignment="Center" Margin="12,0,0,0" />
                <NumericUpDown Value="{Binding StitchYaw}" Minimum="-180" Maximum="180" Increment="1"
                               FormatString="0.#" Width="110" />
                <TextBlock Text="Pitch" VerticalAlignment="Center" />
                <NumericUpDown Value="{Binding StitchPitch}" Minimum="-180" Maximum="180" Increment="1"
                               FormatString="0.#" Width="110" />
                <TextBlock Text="Roll" VerticalAlignment="Center" />
                <NumericUpDown Value="{Binding StitchRoll}" Minimum="-180" Maximum="180" Increment="1"
                               FormatString="0.#" Width="110" />
              </StackPanel>
              <TextBlock Classes="hint"
                         Text="Quality profiles set the codec, CRF, preset, interpolation and HQ tuning; changing one of those switches to Custom. Encoder, audio and the lens settings stay as you set them." />
            </StackPanel>
          </Expander>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBlock Classes="hint" VerticalAlignment="Center" Text="{Binding FfmpegStatus}" />
            <Button Grid.Column="1" Content="Browse for ffmpeg..." Command="{Binding BrowseFfmpegCommand}" />
          </Grid>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding ShowFfmpegDownload}">
            <TextBlock Classes="hint" VerticalAlignment="Center" Text="{Binding FfmpegDownloadNote}" />
            <Button Grid.Column="1" Content="{Binding DownloadFfmpegText}" Command="{Binding DownloadFfmpegCommand}" />
          </Grid>
        </StackPanel>
      </Expander>
      <CheckBox Content="Delete from camera after copying (each file only after its copy is verified)"
                IsChecked="{Binding DeleteAfterCopy}" />
    </StackPanel>

    <!-- Actions -->
    <StackPanel Grid.Row="6" Orientation="Horizontal" Spacing="8">
      <Button Classes="accent" Content="Copy" MinWidth="100" Command="{Binding CopyCommand}" />
      <Button Content="Cancel" MinWidth="100" Command="{Binding CancelCommand}" />
      <Button Content="Open destination folder" Command="{Binding OpenDestinationCommand}" />
    </StackPanel>

    <ProgressBar Grid.Row="7" Minimum="0" Maximum="100" Value="{Binding Progress}" Height="8" />
    <TextBlock Grid.Row="8" Classes="hint" Text="{Binding ProgressText}" TextTrimming="CharacterEllipsis" />

    <Border Grid.Row="9" BorderThickness="1" CornerRadius="4"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <ListBox x:Name="LogList" ItemsSource="{Binding Log}" Background="Transparent"
               FontFamily="Cascadia Mono,Consolas,Menlo,monospace" FontSize="12">
        <ListBox.Styles>
          <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="8,1" />
            <Setter Property="MinHeight" Value="0" />
          </Style>
        </ListBox.Styles>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="x:String">
            <SelectableTextBlock Text="{Binding}" TextWrapping="Wrap" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>
  </Grid>
</Window>
